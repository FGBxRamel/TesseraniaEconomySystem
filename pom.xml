<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.bydora</groupId>
    <artifactId>TesseraniaEconomySystem</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>TES</name>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                org.sqlite is intentionally NOT relocated: sqlite-jdbc's native-library
                                loading and ServiceLoader registration do not survive shade relocation
                                (see xerial/sqlite-jdbc#145). This leaves a small, accepted risk of
                                classpath clashes with another plugin bundling a different sqlite-jdbc
                                version on the same server.

                                InvUI has no such constraint, so it IS relocated below — standard
                                practice to avoid classpath clashes with another plugin on the same
                                server bundling a different InvUI version.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>xyz.xenondevs.invui</pattern>
                                    <shadedPattern>de.bydora.tes.libs.invui</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Local dev/test server (not part of the release build): `mvn run-paper:install verify
                run-paper:run-server` downloads a real Paper server, drops in the freshly-built shaded
                jar, and boots it under target/run. Bound to the IntelliJ run configuration in .run/.
            -->
            <plugin>
                <groupId>blue.lhf</groupId>
                <artifactId>run-paper-maven-plugin</artifactId>
                <version>1.2.1</version>
                <configuration>
                    <minecraftVersion>26.2</minecraftVersion>
                    <acceptEula>true</acceptEula>
                    <serverDirectory>run</serverDirectory>
                    <hotswap>true</hotswap>
                </configuration>
            </plugin>
            <!--
                Downloads the latest Paper build of LuckPerms (an external requirement of the target
                server, see docs/ROADMAP.md) into the dev server's plugins folder. LuckPerms isn't on
                Hangar/Maven Central, only Modrinth and luckperms.net, so it's fetched directly rather
                than as a dependency. Not bound to any phase — invoked explicitly as
                `exec:exec@download-luckperms` alongside the run-paper goals.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>download-luckperms</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/scripts/download-luckperms.sh</executable>
                            <arguments>
                                <argument>${project.build.directory}/run/plugins</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>xenondevs</id>
            <name>xenondevs Releases</name>
            <url>https://repo.xenondevs.xyz/releases</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>lhf-releases</id>
            <name>Ilari's Project Repository</name>
            <url>https://maven.lhf.blue/releases</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.2.build,)</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
        </dependency>
        <dependency>
            <groupId>xyz.xenondevs.invui</groupId>
            <artifactId>invui</artifactId>
            <version>2.3.0</version>
            <exclusions>
                <!--
                    paper-api already brings org.jetbrains:annotations transitively at "provided"
                    scope; invui redeclaring it at "runtime" scope confuses Maven's scope
                    mediation and drops it off the compile classpath entirely (breaks existing
                    @NotNull usages, e.g. in TesBootstrap). Excluding it here leaves paper-api's
                    own transitive resolution as the sole source of truth.
                -->
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
